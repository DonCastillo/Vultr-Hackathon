# Reverse proxy for CrewShift (task 6.2). SITE_ADDRESS comes from .env:
#   <vm-ip>.sslip.io   Caddy gets a Let's Encrypt certificate and serves HTTPS on 443
#                      (and redirects HTTP on 80 to it)
#   http://localhost   plain HTTP, for a local test of the prod stack
{$SITE_ADDRESS} {
	encode zstd gzip
	reverse_proxy web:3000
}
