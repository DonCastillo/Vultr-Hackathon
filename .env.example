# Copy to .env and fill in. Never commit .env.

# Database (local docker compose). The POSTGRES_* values are read by docker-compose.yml;
# keep DATABASE_URL in sync with them.
POSTGRES_USER=crewshift
POSTGRES_PASSWORD=crewshift
POSTGRES_DB=crewshift
POSTGRES_PORT=5432
DATABASE_URL=postgresql://crewshift:crewshift@localhost:5432/crewshift

# Production (docker compose --profile prod). On the VM, set a strong letters-and-digits
# POSTGRES_PASSWORD; web and worker build their own DATABASE_URL from the POSTGRES_* values.
# SITE_ADDRESS is the public host Caddy serves and gets a certificate for: <vm-ip>.sslip.io
SITE_ADDRESS=

# LLM provider: anthropic | vultr
LLM_PROVIDER=anthropic
# Optional: one deadline in ms for every LLM call (default per task: 6-12s),
# and LLM_DISABLED=1 to skip the LLM entirely and use the keyword/template fallbacks.
LLM_TIMEOUT_MS=
LLM_DISABLED=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Vultr Serverless Inference (when credits are available)
VULTR_INFERENCE_API_KEY=
VULTR_MODEL=

# SMS provider: sim | twilio
SMS_PROVIDER=sim
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
